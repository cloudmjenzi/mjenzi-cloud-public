# Mjenzi Cloud form backend settings. Copy to form.env and fill in.
# Never commit the real form.env.

HOST=127.0.0.1
PORT=8082

# Where leads are stored (SQLite file, created automatically)
LEADS_DB=/var/lib/mjenzi/leads.sqlite3

# Who receives new-lead emails (comma separated)
MAIL_TO=cloudmjenzi@gmail.com

# SMTP account used to send them. Gmail settings shown.
# Gmail needs an App Password (not your normal password):
#   Google Account > Security > 2-Step Verification (turn on) > App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# ssl | starttls | none (default: ssl on 465, otherwise starttls)
SMTP_SECURITY=starttls
SMTP_USER=cloudmjenzi@gmail.com
SMTP_PASSWORD=your-16-character-app-password
# Gmail only sends as the signed-in account
MAIL_FROM=cloudmjenzi@gmail.com

# Long random string for downloading leads:
#   curl -H "Authorization: Bearer $ADMIN_TOKEN" https://mjenzi.cloud/api/leads.csv -o leads.csv
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# Only needed if the API runs on a different domain from the website
# ALLOWED_ORIGINS=https://mjenzi.cloud,https://www.mjenzi.cloud
